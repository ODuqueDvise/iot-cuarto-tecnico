[Unit]
Description=Procesador de telemetria del cuarto tecnico (una corrida)
After=influxdb.service

[Service]
Type=oneshot
User=puente
Group=puente
ExecStart=/opt/procesador/.venv/bin/python /opt/procesador/procesador.py --influx --ventana 30m --config /etc/puente/procesador.env
MemoryMax=256M
Nice=10
