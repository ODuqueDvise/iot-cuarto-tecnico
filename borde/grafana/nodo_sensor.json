      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"cuarto\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r.nodo == \"${nodo}\")\n  |> filter(fn: (r) => r._field == \"t\")\n  |> last()\n  |> map(fn: (r) => ({r with _field: if r._field == \"t\" then \"Temperatura\" else r._field}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
