# Correo de las alertas de Grafana. En la Raspberry Pi:
#   sudo cp /tmp/operacion_nueva/correo.env.ejemplo /etc/grafana/correo.env
#   sudo nano /etc/grafana/correo.env
# instalar_operacion.sh lo deja con permisos 600 de root. Nunca guardar este archivo con datos reales en el repositorio.
#
# Gmail: smtp.gmail.com:587 con una contraseña de aplicación (exige verificación en dos pasos en la cuenta);
#        escribir la contraseña de aplicación sin espacios.
# Microsoft 365: smtp.office365.com:587 (la organización debe permitir SMTP AUTH en el buzón).
# Otro proveedor: el servidor y el puerto de envío con STARTTLS que indique.
# Valores con espacios o símbolos van entre comillas dobles.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=remitente@ejemplo.com
GF_SMTP_PASSWORD=contraseña_de_aplicacion
GF_SMTP_FROM_ADDRESS=remitente@ejemplo.com
GF_SMTP_FROM_NAME="Cuarto técnico"
# Destino de las alertas; varias direcciones separadas por punto y coma
CORREO_DESTINO=destino@ejemplo.com
